+                        for s in n.inputs if hasattr(s, 'default_value') and s.type in {'RGBA', 'VALUE'}},
+             'links': [f'{l.from_node.name}.{l.from_socket.name}->{l.to_socket.name}' for s in n.inputs for l in s.links]}
