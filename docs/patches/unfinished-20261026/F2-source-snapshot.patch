+            Check(AntColony.Core.AntPool.Instance.TryAssign(15), "fixture assigns fifteen soldiers");
+            Call(c0, "RestoreTroops", 15, 0f);
+            Check(escape.TryReturn(), "start grouped troop boarding"); escape.Tick(10);
