+            second.PersonalState.rageRemaining = 0;
+
+            siteObject = new GameObject("C2 boss/site fixture"); siteObject.transform.position = first.Position + Vector3.forward * 22;
+            var site = siteObject.AddComponent<ExpeditionSite>();
