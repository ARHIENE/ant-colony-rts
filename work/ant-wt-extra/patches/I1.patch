diff --git a/Assets/_Project/Scripts/Units/CommanderBossEquipment.cs b/Assets/_Project/Scripts/Units/CommanderBossEquipment.cs
new file mode 100644
index 0000000..2fb923a
--- /dev/null
+++ b/Assets/_Project/Scripts/Units/CommanderBossEquipment.cs
@@ -0,0 +1,55 @@
+using System.Linq;
+using AntColony.Boss;
+using AntColony.Core;
+using AntColony.World;
+using UnityEngine;
+
+namespace AntColony.Units
+{
+    public partial class EquipmentItem
+    {
+        // G22가 종류만 확정했으므로 효과 수치는 잠정 밸런스다.
+        public const float DurableCapacity = 200, HeatReduction = .5f, AreaRadius = 3;
+        public float HeatResistance => bossEquipment == BossEquipmentKind.HeatShield ? HeatReduction : 0;
+        public float AttackRadius => bossEquipment == BossEquipmentKind.AreaWeapon ? AreaRadius : 0;
+        public string BossLabel => bossEquipment switch {
+            BossEquipmentKind.Durable => "A 고유 내구 갑옷 (내구 " + Mathf.CeilToInt(durability) + "/" + DurableCapacity + ")",
+            BossEquipmentKind.HeatShield => "B 방열 갑옷", BossEquipmentKind.AreaWeapon => "C 범위 분사기", _ => "" };
+        public static EquipmentItem BossReward(BossId boss, string parcelId) => boss == BossId.D ? null : new EquipmentItem {
+            id = "boss-equipment:" + parcelId, quality = 3,
+            slot = boss == BossId.C ? EquipmentSlot.Weapon : EquipmentSlot.Armor,
+            weapon = boss == BossId.C ? WeaponKind.AcidSprayer : WeaponKind.Mandible,
+            bossEquipment = boss == BossId.A ? BossEquipmentKind.Durable : boss == BossId.B ? BossEquipmentKind.HeatShield : BossEquipmentKind.AreaWeapon,
+            durability = boss == BossId.A ? DurableCapacity : 0 };
+    }
+
+    public partial class CommanderAnt
+    {
+        public float HeatResistance => EquippedArmor?.HeatResistance ?? 0;
+        public void TakeHeatDamage(float amount) => TakeDamage(amount * (1 - HeatResistance));
+        private float AbsorbDurableDamage(float amount)
+        {
+            var armor = EquippedArmor;
+            if (armor?.bossEquipment != BossEquipmentKind.Durable) return amount;
+            var absorbed = Mathf.Min(armor.durability, amount * .5f);
+            armor.durability -= absorbed;
+            return amount - absorbed;
+        }
+        private void StrikeWithEquipment(IDamageable target, float damage)
+        {
+            var radius = Weapon?.AttackRadius ?? 0;
+            if (radius <= 0) { target.TakeDamage(damage); return; }
+            // 기존 범위 스킬의 아군/중립/대공 판정과 처치 경험치를 그대로 쓴다.
+            DamageArea(target.Position, radius, damage, Role);
+        }
+        public static bool DeliverBossEquipment(string parcelId, Vector3 home)
+        {
+            var research = CampaignResearch.Instance;
+            var parcel = research?.BossProgress.Cargo.FirstOrDefault(p => p.id == parcelId);
+            if (parcel == null || !research.DeliverBossReward(parcelId)) return false;
+            var item = EquipmentItem.BossReward((BossId)parcel.boss, parcel.id);
+            if (item != null && EquipmentInventory.Instance?.Add(item) != true) EquipmentLoot.Drop(home, new[] { item });
+            return true;
+        }
+    }
+}
diff --git a/Assets/_Project/Scripts/Units/CommanderBossWork.cs b/Assets/_Project/Scripts/Units/CommanderBossWork.cs
new file mode 100644
index 0000000..1be8659
--- /dev/null
+++ b/Assets/_Project/Scripts/Units/CommanderBossWork.cs
@@ -0,0 +1,69 @@
+using System.Linq;
+using AntColony.Boss;
+using AntColony.Core;
+using AntColony.World;
+using UnityEngine;
+
+namespace AntColony.Units
+{
+    public partial class CommanderAnt
+    {
+        public string BossCarrier => "commander:" + PersonalState.id;
+        public int BossCargoCount => CampaignResearch.Instance?.BossProgress.Cargo.Where(p => p.carrier == BossCarrier).Sum(p => p.count) ?? 0;
+
+        public bool CommandCollectBossReward(BossStronghold target)
+        {
+            if (target == null || !target.Revealed || !CanReceiveOrders || LabUpgradeBusy || IsConstructing || IsWorking
+                || IsCarrying || BossCargoCount > 0 || !CampaignResearch.Instance.BossProgress.Defeated(target.Id)
+                || !CampaignResearch.Instance.CaptureState().bosses.unclaimed.Any(p => p.boss == (int)target.Id)
+                || LoadCapacity < (target.Id == BossId.A ? 2 : 1)) return false;
+            var site = target.GetComponent<ExpeditionSite>();
+            var point = site?.Boss != null ? site.Boss.Position : target.transform.position;
+            if (!TryWorkApproach(point, out var approach)) return false;
+            CommandStop(); WorkState.bossPickup = (int)target.Id;
+            SetMoveDestination(approach);
+            TickBossRewardWork(); return true;
+        }
+
+        private bool TickBossRewardWork()
+        {
+            if (!CanReceiveOrders) return false;
+            if (WorkState.bossPickup >= 0)
+            {
+                var target = FindObjectsByType<BossStronghold>(FindObjectsSortMode.None)
+                    .FirstOrDefault(s => (int)s.Id == WorkState.bossPickup);
+                if (target == null || !target.Revealed) { WorkState.bossPickup = -1; return false; }
+                var site = target.GetComponent<ExpeditionSite>();
+                var point = site?.Boss != null ? site.Boss.Position : target.transform.position;
+                if ((Position - point).sqrMagnitude > 9 || !HasReachedDestination())
+                {
+                    if (!TryWorkApproach(point, out var approach)) { CommandStop(); return false; }
+                    SetMoveDestination(approach); return true;
+                }
+                var id = target.Id;
+                CommandStop();
+                if (BossCargoCount == 0 && LoadCapacity >= (id == BossId.A ? 2 : 1)
+                    && CampaignResearch.Instance.BossProgress.TryAcquire(id, BossCarrier, out _))
+                { if (site != null) site.RewardsClaimed = true; }
+            }
+            if (BossCargoCount == 0 || IsAwayFromHome || IsEmbarked || IsHostile) return false;
+            if ((Position - HomeReturnPoint.Anchor).sqrMagnitude > 49)
+            {
+                if (!IsWorking && !IsInCombat && TryWorkApproach(HomeReturnPoint.Anchor, out var approach))
+                { SetMoveDestination(approach); return true; }
+                return false;
+            }
+            foreach (var parcel in CampaignResearch.Instance.BossProgress.Cargo.Where(p => p.carrier == BossCarrier).ToArray())
+                DeliverBossEquipment(parcel.id, Position);
+            return false;
+        }
+
+        // 사망·영구 이탈·파괴에서만 호출. 씬 재구성과 정상 비활성화는 소실이 아니다.
+        public void LoseBossCargo()
+        {
+            var progress = CampaignResearch.Instance?.BossProgress;
+            if (progress == null) return;
+            foreach (var parcel in progress.Cargo.Where(p => p.carrier == BossCarrier).ToArray()) progress.LoseCargo(parcel.id);
+        }
+    }
+}
